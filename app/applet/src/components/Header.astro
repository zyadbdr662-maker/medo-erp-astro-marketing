---
// Header.astro - Top Navigation with SAP/Stripe styling
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200">
  <!-- Top announcement bar -->
  <div class="bg-dark text-white text-xs py-2 px-4 text-center font-body">
    <span class="inline-flex items-center gap-2">
      <span class="px-2 py-0.5 rounded bg-sap text-white font-mono font-bold text-[10px]">جديد</span>
      <span>إطلاق نظام MeDo ERP النسخة 3.5 السحابية — دعم كامل لفروق العملات والباركود السريع.</span>
      <a href="https://medo-erp-cloud.vercel.app" target="_blank" rel="noopener noreferrer" class="underline hover:text-sky-300 font-bold rtl:mr-1">تجربة النظام ←</a>
    </span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-navy to-sap flex items-center justify-center text-white font-heading font-black text-2xl shadow-md group-hover:scale-105 transition-transform duration-300">
          M
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-black text-xl text-navy tracking-tight group-hover:text-sap transition-colors">MeDo ERP</span>
          <span class="text-[10px] text-gray-text font-mono tracking-wider">Cloud Financials</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 font-body">
      <a href="/about" class="px-3.5 py-2 text-sm font-semibold text-navy hover:text-sap transition rounded-lg hover:bg-ivory">من نحن</a>
      
      <!-- Solutions Dropdown Trigger -->
      <div class="relative group">
        <button class="px-3.5 py-2 text-sm font-semibold text-navy hover:text-sap transition rounded-lg hover:bg-ivory inline-flex items-center gap-1.5">
          <span>الحلول والقطاعات</span>
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <!-- Mega Menu Dropdown -->
        <div class="absolute top-full right-0 w-80 bg-white rounded-2xl shadow-2xl border border-gray-200 p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50">
          <div class="space-y-1">
            <div class="px-3 py-2 border-b border-gray-100">
              <span class="text-xs font-heading font-bold text-gray-text uppercase tracking-wider">حلول مخصصة للأنشطة والقطاعات</span>
            </div>
            <a href="/#solutions" class="block p-3 rounded-lg hover:bg-ivory transition">
              <h4 class="text-sm font-heading font-bold text-navy flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-sap"></span>
                البقالات والتجزئة
              </h4>
              <p class="text-xs text-gray-text mt-1">سرعة البيع، جرد فوري، وقراءة الباركود المتعدد.</p>
            </a>
            <a href="/#solutions" class="block p-3 rounded-lg hover:bg-ivory transition">
              <h4 class="text-sm font-heading font-bold text-navy flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                الصيدليات والمراكز الطبية
              </h4>
              <p class="text-xs text-gray-text mt-1">تتبع تواريخ الانتهاء، بدائل الأدوية، والجرعات.</p>
            </a>
            <a href="/#solutions" class="block p-3 rounded-lg hover:bg-ivory transition">
              <h4 class="text-sm font-heading font-bold text-navy flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-600"></span>
                الشركات والمجموعات
              </h4>
              <p class="text-xs text-gray-text mt-1">ربط الفروع، توحيد القوائم المالية، وفروق العملة.</p>
            </a>
            <a href="/#solutions" class="block p-3 rounded-lg hover:bg-ivory transition">
              <h4 class="text-sm font-heading font-bold text-navy flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-purple-600"></span>
                المطاعم والكافيهات
              </h4>
              <p class="text-xs text-gray-text mt-1">طاولات، مطبخ، دليفري، وتكاليف تصنيع الوجبات.</p>
            </a>
          </div>
        </div>
      </div>

      <a href="/#pricing" class="px-3.5 py-2 text-sm font-semibold text-navy hover:text-sap transition rounded-lg hover:bg-ivory">الأسعار</a>
      <a href="/#testimonials" class="px-3.5 py-2 text-sm font-semibold text-navy hover:text-sap transition rounded-lg hover:bg-ivory">العملاء</a>
      <a href="/blog" class="px-3.5 py-2 text-sm font-semibold text-navy hover:text-sap transition rounded-lg hover:bg-ivory">المدونة</a>
      <a href="/#faq" class="px-3.5 py-2 text-sm font-semibold text-navy hover:text-sap transition rounded-lg hover:bg-ivory">الأسئلة</a>
    </nav>

    <!-- Action Area: Search & CTA -->
    <div class="flex items-center gap-3">
      <!-- Search Trigger Button -->
      <button onclick="document.getElementById('search-bar').classList.toggle('hidden')" aria-label="البحث" class="p-2.5 rounded-lg text-navy hover:text-sap hover:bg-ivory transition">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- CTA Button (Vercel / Linear Style) -->
      <a 
        href="https://medo-erp-cloud.vercel.app" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-cta text-white font-heading font-bold text-sm hover:bg-cta-hover hover:scale-[1.02] active:scale-[0.98] shadow-sm hover:shadow-cta-glow transition-all duration-300"
      >
        ابدأ الآن
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" aria-label="القائمة" class="lg:hidden p-2 rounded-lg text-navy hover:bg-ivory transition">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Search Modal / Bar -->
  <div id="search-bar" class="hidden border-t border-gray-200 bg-ivory py-3.5 px-4">
    <div class="max-w-3xl mx-auto flex items-center gap-3">
      <svg class="w-5 h-5 text-gray-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        placeholder="ابحث في حلول وموديولات MeDo ERP (مثال: نقاط البيع، الفواتير، التقارير)..." 
        class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2 text-sm text-navy focus:outline-hidden focus:border-sap"
      />
      <button onclick="document.getElementById('search-bar').classList.add('hidden')" class="text-xs text-gray-text hover:text-navy font-semibold px-2 py-1">إغلاق</button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-200 px-4 py-6 space-y-4 shadow-xl max-h-[80vh] overflow-y-auto font-body">
    <div class="space-y-1">
      <p class="px-3 text-xs font-heading font-bold text-gray-text uppercase tracking-wider">القائمة الرئيسية</p>
      <a href="/about" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">من نحن</a>
      <a href="/#solutions" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">الفوترة والامتثال الضريبي</a>
      <a href="/#solutions" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">إدارة المخزون والمستودعات</a>
      <a href="/#solutions" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">نقاط البيع السحابية (POS)</a>
      <a href="/#solutions" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">التقارير والمحاسبة العامة</a>
    </div>

    <div class="border-t border-gray-100 pt-3 space-y-1">
      <p class="px-3 text-xs font-heading font-bold text-gray-text uppercase tracking-wider">روابط سريعة</p>
      <a href="/#pricing" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">الأسعار والخطط</a>
      <a href="/#testimonials" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">قصص نجاح العملاء</a>
      <a href="/blog" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">المدونة والمقالات</a>
      <a href="/#faq" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">الأسئلة الشائعة</a>
      <a href="/privacy" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">سياسة الخصوصية</a>
      <a href="/terms" onclick="document.getElementById('mobile-menu').classList.add('hidden')" class="block px-3 py-2.5 rounded-lg text-navy font-medium hover:bg-ivory">الشروط والأحكام</a>
    </div>

    <div class="pt-4 border-t border-gray-100">
      <a 
        href="https://medo-erp-cloud.vercel.app" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full flex items-center justify-center py-3 rounded-lg bg-cta text-white font-heading font-bold text-sm shadow-md"
      >
        ابدأ الآن مجاناً
      </a>
    </div>
  </div>
</header>
