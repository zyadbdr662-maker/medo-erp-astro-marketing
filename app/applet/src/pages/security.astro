---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="معايير التشفير والأمان">
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-navy mb-6">معايير التشفير والأمان</h1>
      <p class="text-xl mb-12">أمان بياناتك هو أولويتنا القصوى.</p>
      
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="p-6 bg-ivory rounded-lg">
          <h3 class="text-xl font-bold mb-2">تشفير AES-256</h3>
          <p>لبيانات المخزنة.</p>
        </div>
        <div class="p-6 bg-ivory rounded-lg">
          <h3 class="text-xl font-bold mb-2">تشفير TLS 1.3</h3>
          <p>لبيانات المنقولة.</p>
        </div>
        <div class="p-6 bg-ivory rounded-lg">
          <h3 class="text-xl font-bold mb-2">نسخ احتياطي</h3>
          <p>كل ساعة.</p>
        </div>
        <div class="p-6 bg-ivory rounded-lg">
          <h3 class="text-xl font-bold mb-2">سجل تدقيق</h3>
          <p>سجل تدقيق (Audit Log) لكل عملية.</p>
        </div>
      </div>
      
      <h2 class="text-3xl font-bold text-navy mb-4">الامتثال</h2>
      <p>متوافق مع معايير SAP Fiori و GDPR.</p>
    </div>
  </section>
</Layout>
