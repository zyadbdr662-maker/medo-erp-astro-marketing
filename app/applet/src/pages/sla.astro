---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="اتفاقية مستوى الخدمة (SLA)">
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-navy mb-10">اتفاقية مستوى الخدمة (SLA)</h1>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse border border-gray-200">
          <thead class="bg-navy text-white">
            <tr>
              <th class="p-4 border">المعيار</th>
              <th class="p-4 border">التفاصيل</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-4 border">وقت التشغيل (Uptime)</td>
              <td class="p-4 border">99.9%</td>
            </tr>
            <tr>
              <td class="p-4 border">وقت الاستجابة للدعم</td>
              <td class="p-4 border">خلال 4 ساعات (Pro) / خلال ساعة (Enterprise)</td>
            </tr>
            <tr>
              <td class="p-4 border">النسخ الاحتياطي</td>
              <td class="p-4 border">كل ساعة</td>
            </tr>
            <tr>
              <td class="p-4 border">استعادة البيانات</td>
              <td class="p-4 border">خلال 24 ساعة</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <h2 class="text-3xl font-bold text-navy mt-10 mb-4">التعويضات</h2>
      <p>إذا انخفض وقت التشغيل عن 99.9%، يحق للعميل الحصول على رصيد إضافي.</p>
    </div>
  </section>
</Layout>
