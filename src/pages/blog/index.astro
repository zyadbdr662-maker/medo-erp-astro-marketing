---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

let posts = [];
let error = null;

try {
  const { data, error: fetchError } = await supabase
    .from('blog_posts')
    .select('*')
    .eq('published', true)
    .order('created_at', { ascending: false });

  if (fetchError) throw fetchError;
  posts = data || [];
} catch (e) {
  console.warn('Could not fetch blog posts, using fallback.', e);
  posts = [];
}

const fallbackPosts = [
  { slug: 'how-to-choose-accounting-system', title: 'كيف تختار نظام محاسبي مناسب لمحلك التجاري؟', excerpt: 'أهم المعايير لاختيار نقطة بيع ذكية تدعم الباركود السريع وتمنع العجز المالي.', category: 'أنظمة التجزئة' },
  { slug: 'common-accounting-errors-yemen', title: '5 أخطاء محاسبية شائعة في السوق اليمني وكيفية تجنبها', excerpt: 'تجاهل فروق الصرف، تأخير إدخال المشتريات، والجرد اليدوي — أسباب تؤدي لخسائر خفية.', category: 'إدارة مالية' },
  { slug: 'cloud-erp-transformation-guide', title: 'دليل الانتقال بأعمالك إلى السحابة خطوة بخطوة', excerpt: 'لماذا يتخلى كبار التجار عن السيرفرات المحلية المكلفة ويتجهون إلى المنظومات السحابية.', category: 'الحوسبة السحابية' }
];

const displayPosts = posts.length > 0 ? posts : fallbackPosts;
---

<Layout 
  title="المدونة - مقالات وأخبار MeDo ERP" 
  description="تابع أحدث المقالات والأخبار حول تطوير المحاسبة السحابية في اليمن وحلول MeDo ERP المتكاملة."
>
  <section class="py-20 bg-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="font-heading font-black text-4xl sm:text-5xl text-navy mb-6">المدونة</h1>
        <p class="text-gray-text text-lg max-w-2xl mx-auto">أحدث المقالات حول الإدارة المالية، المحاسبة السحابية، وتقنيات ERP في اليمن.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {displayPosts.map((post) => (
          <article class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition-all flex flex-col overflow-hidden">
            <div class="p-8 flex flex-col flex-grow">
              <span class="text-xs font-mono-num text-sap font-bold mb-3 block">{post.category}</span>
              <h2 class="font-heading font-bold text-xl text-navy mb-4 group-hover:text-sap transition-colors line-clamp-2">
                {post.title}
              </h2>
              <p class="font-body text-sm text-gray-text mb-6 flex-grow line-clamp-3">{post.excerpt}</p>
              <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 font-heading font-bold text-sap hover:text-sap-hover text-sm">
                <span>اقرأ المزيد</span>
                <span>←</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
