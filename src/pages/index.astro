---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Solutions from '../components/Solutions.astro';
import Stats from '../components/Stats.astro';
import Pricing from '../components/Pricing.tsx';
import Testimonials from '../components/Testimonials.astro';
import BlogSection from '../components/BlogSection.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<Layout 
  title="MeDo ERP SaaS | منظومة تخطيط الموارد السحابية المتكاملة بمعايير SAP و Linear" 
  description="منظومة MeDo ERP السحابية المتكاملة للشركات والمؤسسات — فواتير ذكية، نقاط بيع سحابية، إدارة المخزون والمستودعات، والمحاسبة المالية الدقيقة."
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Trust Bar -->
  <TrustBar />

  <!-- 3. Solutions Grid -->
  <Solutions />

  <!-- 4. Statistics Section -->
  <Stats />

  <!-- 5. Pricing Section (React Island) -->
  <Pricing client:load />

  <!-- 6. Testimonials -->
  <Testimonials />

  <!-- 7. Blog & Resources Section (New) -->
  <BlogSection />

  <!-- 8. FAQ Section -->
  <FAQ />

  <!-- 9. Final CTA -->
  <FinalCTA />
</Layout>
