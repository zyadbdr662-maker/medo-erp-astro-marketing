---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

let successMessage = null;
let errorMessage = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const name = formData.get('name');
  const email = formData.get('email');
  const message = formData.get('message');
  
  if (supabase) {
    const { error } = await supabase.from('contact_messages').insert({ name, email, message });
    if (error) {
      errorMessage = 'حدث خطأ أثناء الإرسال.';
    } else {
      successMessage = 'تم إرسال رسالتك بنجاح!';
    }
  } else {
      errorMessage = 'تعذر الاتصال بقاعدة البيانات.';
  }
}
---

<Layout title="تواصل معنا | MeDo ERP">
  <section class="py-20 bg-ivory">
    <div class="max-w-2xl mx-auto px-4">
      <h1 class="text-4xl font-black text-navy mb-12 text-center">تواصل معنا</h1>
      
      {successMessage && <p class="bg-green-100 text-green-700 p-4 mb-6 rounded-lg text-center">{successMessage}</p>}
      {errorMessage && <p class="bg-red-100 text-red-700 p-4 mb-6 rounded-lg text-center">{errorMessage}</p>}
      
      <form method="POST" class="space-y-6">
        <div>
          <label class="block font-bold mb-2">الاسم</label>
          <input type="text" name="name" required class="w-full p-3 rounded-lg border" />
        </div>
        <div>
          <label class="block font-bold mb-2">البريد الإلكتروني</label>
          <input type="email" name="email" required class="w-full p-3 rounded-lg border" />
        </div>
        <div>
          <label class="block font-bold mb-2">الرسالة</label>
          <textarea name="message" required class="w-full p-3 rounded-lg border h-32"></textarea>
        </div>
        <button type="submit" class="w-full bg-sap text-white p-4 rounded-lg font-bold">إرسال</button>
      </form>
    </div>
  </section>
</Layout>
