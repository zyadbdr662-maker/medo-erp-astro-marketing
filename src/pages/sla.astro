---
import Layout from '../layouts/Layout.astro';
---
<Layout title="اتفاقية مستوى الخدمة SLA | MeDo ERP">
  <section class="py-20 bg-ivory">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-black text-navy mb-12">اتفاقية مستوى الخدمة SLA</h1>
      <table class="w-full text-right border-collapse">
        <thead class="bg-gray-200">
          <tr>
            <th class="p-4 border">البند</th>
            <th class="p-4 border">المستوى</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-4 border">وقت التشغيل</td>
            <td class="p-4 border">99.9%</td>
          </tr>
          <tr>
            <td class="p-4 border">وقت الاستجابة</td>
            <td class="p-4 border">أقل من 2 ساعة</td>
          </tr>
          <tr>
            <td class="p-4 border">النسخ الاحتياطي</td>
            <td class="p-4 border">كل ساعة</td>
          </tr>
          <tr>
            <td class="p-4 border">استعادة البيانات</td>
            <td class="p-4 border">خلال 4 ساعات</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>
