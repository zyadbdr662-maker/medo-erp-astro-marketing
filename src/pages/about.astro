---
import Layout from '../layouts/Layout.astro';
---

<Layout title="من نحن | MeDo ERP">
  <section class="py-20 bg-ivory">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-black text-navy mb-6">من نحن</h1>
      <p class="text-lg text-gray-700 mb-12">MeDo ERP نظام سحابي يمني بمعايير SAP.</p>
      
      <div class="space-y-12">
        <section>
          <h2 class="text-2xl font-bold text-navy mb-4">قصتنا</h2>
          <p>بدأت رحلتنا من إدراكنا لحاجة السوق اليمني لنظام محاسبي متطور وسهل الاستخدام، يجمع بين قوة أنظمة ERP العالمية وسهولة التعامل مع البيئة المحلية.</p>
        </section>
        
        <section>
          <h2 class="text-2xl font-bold text-navy mb-4">قيمنا</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 bg-white rounded-xl shadow-sm border">
              <h3 class="font-bold text-lg mb-2">الدقة</h3>
              <p>نؤمن بأن المحاسبة تعني الدقة المتناهية.</p>
            </div>
            <div class="p-6 bg-white rounded-xl shadow-sm border">
              <h3 class="font-bold text-lg mb-2">الأمان</h3>
              <p>بياناتك محمية بأحدث تقنيات التشفير.</p>
            </div>
            <div class="p-6 bg-white rounded-xl shadow-sm border">
              <h3 class="font-bold text-lg mb-2">التطوير</h3>
              <p>نعمل باستمرار على تحسين وتطوير أدواتنا.</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>
