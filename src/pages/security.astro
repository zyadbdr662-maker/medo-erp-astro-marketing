---
import Layout from '../layouts/Layout.astro';
---
<Layout title="معايير التشفير والأمان | MeDo ERP">
  <section class="py-20 bg-ivory">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-black text-navy mb-12">معايير التشفير والأمان</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-6 bg-white rounded-xl shadow-sm border">
          <h2 class="text-xl font-bold mb-2">AES-256</h2>
          <p>تشفير البيانات الحساسة وفق أعلى المعايير المصرفية.</p>
        </div>
        <div class="p-6 bg-white rounded-xl shadow-sm border">
          <h2 class="text-xl font-bold mb-2">TLS 1.3</h2>
          <p>تأمين الاتصال بين المستخدم والخوادم ببروتوكول حديث.</p>
        </div>
        <div class="p-6 bg-white rounded-xl shadow-sm border">
          <h2 class="text-xl font-bold mb-2">نسخ احتياطي كل ساعة</h2>
          <p>حماية من فقدان البيانات بأخذ نسخ دورية تلقائية.</p>
        </div>
        <div class="p-6 bg-white rounded-xl shadow-sm border">
          <h2 class="text-xl font-bold mb-2">سجل تدقيق</h2>
          <p>تتبع كامل لجميع العمليات داخل النظام لضمان النزاهة.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
