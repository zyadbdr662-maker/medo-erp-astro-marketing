---
---
<section id="testimonials" class="py-24 bg-white border-t border-gray-200/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-sap text-xs font-heading font-bold mb-4 border border-blue-200">
        <span>تجارب حقيقية</span>
      </div>
      <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-navy tracking-tight mb-4">
        شركاء النجاح يشهدون بتميزنا
      </h2>
      <p class="font-body text-base text-gray-text">
        استمع لآراء نخبة من رواد الأعمال والمجموعات التجارية الذين اعتمدوا على MeDo ERP لإدارة أعمالهم.
      </p>
    </div>

    <!-- 3 Ivory Testimonial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1 -->
      <div class="bg-ivory p-8 rounded-2xl border border-gray-200/90 hover:border-sap hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between reveal-on-scroll">
        <div>
          <!-- 5 Golden Stars -->
          <div class="flex items-center gap-1 text-gold mb-6">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <p class="font-body text-navy text-sm sm:text-base leading-relaxed italic mb-8">
            "انتقالنا إلى منظومة MeDo ERP السحابية حل أزمة تباين أسعار الصرف بين فروعنا في صنعاء وعدن جذرياً. الآن تقارير الأرباح والخسائر تصدر تلقائياً بدقة متناهية ودون أي تضارب."
          </p>
        </div>

        <div class="flex items-center gap-4 pt-6 border-t border-gray-200/60">
          <div class="w-12 h-12 rounded-full bg-blue-100 text-sap font-heading font-black flex items-center justify-center text-base shrink-0 border border-blue-200">
            ع.ز
          </div>
          <div>
            <h4 class="font-heading font-bold text-navy text-base">أ. عبدالله بن زياد</h4>
            <p class="font-body text-xs text-gray-text">المدير العام — مجموعة بن زياد التجارية</p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-ivory p-8 rounded-2xl border border-gray-200/90 hover:border-sap hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between reveal-on-scroll">
        <div>
          <!-- 5 Golden Stars -->
          <div class="flex items-center gap-1 text-gold mb-6">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <p class="font-body text-navy text-sm sm:text-base leading-relaxed italic mb-8">
            "واجهة النظام مريحة للغاية ومطابقة لمعايير SAP وLinear العالمية. استطاع موظفونا تعلم النظام واستخدامه بسلاسة خلال يوم واحد فقط، ونقاط البيع أوفلاين حلت مشكلة انقطاع النت تماماً."
          </p>
        </div>

        <div class="flex items-center gap-4 pt-6 border-t border-gray-200/60">
          <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-800 font-heading font-black flex items-center justify-center text-base shrink-0 border border-emerald-200">
            م.ن
          </div>
          <div>
            <h4 class="font-heading font-bold text-navy text-base">م. طارق النهاري</h4>
            <p class="font-body text-xs text-gray-text">مدير التشغيل — المصنع الحديث الوطني</p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-ivory p-8 rounded-2xl border border-gray-200/90 hover:border-sap hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between reveal-on-scroll">
        <div>
          <!-- 5 Golden Stars -->
          <div class="flex items-center gap-1 text-gold mb-6">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <p class="font-body text-navy text-sm sm:text-base leading-relaxed italic mb-8">
            "النسخ الاحتياطي التلقائي المشفر كل ساعة منحنا راحة بال لا تقدر بثمن. الترحيل من نظامنا القديم تم بدون أي توقف عن العمل، وفريق الدعم الفني متواجد دائماً ويجيب في غضون دقائق."
          </p>
        </div>

        <div class="flex items-center gap-4 pt-6 border-t border-gray-200/60">
          <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-800 font-heading font-black flex items-center justify-center text-base shrink-0 border border-amber-200">
            هـ.س
          </div>
          <div>
            <h4 class="font-heading font-bold text-navy text-base">أ. هيثم السعيدي</h4>
            <p class="font-body text-xs text-gray-text">مدير الحسابات — شركة النهج الأخير</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
