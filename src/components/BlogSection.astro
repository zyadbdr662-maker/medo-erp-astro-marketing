---
---
<section id="blog" class="py-24 bg-white border-t border-gray-200/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-sap text-xs font-heading font-bold mb-4 border border-blue-200">
        <span>مقالات ومصادر</span>
      </div>
      <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-navy tracking-tight mb-4">
        اكتشف أسرار المحاسبة وإدارة الأعمال
      </h2>
      <p class="font-body text-base text-gray-text">
        دليلك العملي لتطوير الأداء المالي، أتمتة الفواتير، والتحول السحابي الناجح في السوق المحلي.
      </p>
    </div>

    <!-- 3 Article Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Article 1 -->
      <article class="group bg-ivory rounded-2xl border border-gray-200 overflow-hidden hover:border-sap hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between reveal-on-scroll">
        <div>
          <!-- Visual SVG Banner -->
          <div class="h-48 bg-gradient-to-tr from-navy to-[#1A3860] p-6 flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <svg class="w-20 h-20 text-sky-400 group-hover:scale-110 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"/>
              <line x1="8" y1="21" x2="16" y2="21" stroke-width="2"/>
              <line x1="12" y1="17" x2="12" y2="21" stroke-width="2"/>
              <path d="M7 8h10M7 12h6" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-2 text-xs font-mono-num text-gray-text mb-3">
              <span>📅 18 أكتوبر 2026</span>
              <span>•</span>
              <span class="text-sap font-body font-semibold">أنظمة التجزئة</span>
            </div>
            <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors line-clamp-2">
              كيف تختار نظام محاسبي مناسب لمحلك التجاري؟
            </h3>
            <p class="font-body text-sm text-gray-text leading-relaxed line-clamp-3">
              أهم المعايير لاختيار نقطة بيع ذكية تدعم الباركود السريع وتمنع العجز المالي وتعمل دون توقف عند انقطاع الشبكة.
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <a href="#contact" class="inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
            <span>اقرأ المزيد</span>
            <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- Article 2 -->
      <article class="group bg-ivory rounded-2xl border border-gray-200 overflow-hidden hover:border-sap hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between reveal-on-scroll">
        <div>
          <!-- Visual SVG Banner -->
          <div class="h-48 bg-gradient-to-tr from-dark to-[#162D4A] p-6 flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <svg class="w-20 h-20 text-gold group-hover:scale-110 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-2 text-xs font-mono-num text-gray-text mb-3">
              <span>📅 12 أكتوبر 2026</span>
              <span>•</span>
              <span class="text-sap font-body font-semibold">إدارة مالية</span>
            </div>
            <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors line-clamp-2">
              5 أخطاء محاسبية شائعة في السوق اليمني وكيفية تجنبها
            </h3>
            <p class="font-body text-sm text-gray-text leading-relaxed line-clamp-3">
              تجاهل فروق الصرف، تأخير إدخال المشتريات، والجرد اليدوي — أسباب تؤدي لخسائر خفية وكيف يعالجها ERP السحابي آلياً.
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <a href="#contact" class="inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
            <span>اقرأ المزيد</span>
            <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- Article 3 -->
      <article class="group bg-ivory rounded-2xl border border-gray-200 overflow-hidden hover:border-sap hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between reveal-on-scroll">
        <div>
          <!-- Visual SVG Banner -->
          <div class="h-48 bg-gradient-to-tr from-[#003B8E] to-cta p-6 flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <svg class="w-20 h-20 text-white group-hover:scale-110 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M19 16.9A5 5 0 0 0 18 7h-1.26a8 8 0 1 0-11.62 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <polyline points="13 11 9 15 13 19" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-2 text-xs font-mono-num text-gray-text mb-3">
              <span>📅 05 أكتوبر 2026</span>
              <span>•</span>
              <span class="text-sap font-body font-semibold">الحوسبة السحابية</span>
            </div>
            <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors line-clamp-2">
              دليل الانتقال بأعمالك إلى السحابة خطوة بخطوة
            </h3>
            <p class="font-body text-sm text-gray-text leading-relaxed line-clamp-3">
              لماذا يتخلى كبار التجار عن السيرفرات المحلية المكلفة ويتجهون إلى المنظومات السحابية الآمنة وذات النسخ الاحتياطي التلقائي.
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <a href="#contact" class="inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
            <span>اقرأ المزيد</span>
            <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </article>

    </div>

  </div>
</section>
