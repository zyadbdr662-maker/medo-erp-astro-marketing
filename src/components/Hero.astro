---
---
<section class="relative bg-gradient-to-b from-[#0A192F] via-[#0E223D] to-[#1D2D3E] text-white pt-16 pb-24 overflow-hidden">
  
  <!-- Subtle enterprise background grid pattern -->
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="sap-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#FFFFFF" stroke-width="0.8" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#sap-grid)" />
    </svg>
  </div>

  <!-- Ambient blue blur orb -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-sap-blue/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Right Column: Content & Actions -->
      <div class="lg:col-span-6 text-right">
        
        <!-- Pre-badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/80 border border-blue-400/30 text-blue-300 text-xs font-semibold mb-6 shadow-inner">
          <span class="w-2 h-2 rounded-full bg-sap-blue animate-pulse"></span>
          <span>منظومة تخطيط الموارد السحابية الأولى بمعايير SAP</span>
        </div>

        <!-- Huge Headline (5xl-7xl) -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[64px] font-black leading-[1.15] tracking-tight mb-6">
          أدر أعمالك بذكاء،<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-white">
            من أي مكان
          </span>
        </h1>

        <!-- Enterprise Description (xl-2xl) -->
        <p class="text-lg sm:text-xl lg:text-2xl text-slate-300 font-light leading-relaxed mb-8 max-w-xl">
          منظومة MeDo ERP السحابية المتكاملة — فواتير ذكية، إدارة مخزون متعدد الفروع، علاقات عملاء، وتقارير مالية فورية للمؤسسات والشركات الطموحة.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a href="#pricing" class="px-8 py-4 rounded-lg bg-sap-blue text-white font-bold text-base hover:bg-sap-blue-hover shadow-lg hover:shadow-blue-500/30 transition text-center flex items-center justify-center gap-2">
            <span>ابدأ التجربة المجانية</span>
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          
          <a href="https://wa.me/967773586047?text=مرحباً، أود حجز عرض توضيحي مباشر لمنظومة MeDo ERP" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-base border border-white/30 backdrop-blur-xs transition text-center flex items-center justify-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.768-2.587 5.768-5.766.001-3.182-2.585-5.806-5.768-5.806zm0 10.455c-.908 0-1.637-.24-2.341-.663l-.167-.099-1.579.414.421-1.539-.109-.174c-.459-.731-.726-1.554-.725-2.528.001-2.463 2.003-4.465 4.468-4.465 2.463 0 4.466 2.002 4.467 4.465 0 2.464-2.004 4.589-4.435 4.589z"/>
            </svg>
            <span>اطلب عرضاً توضيحياً</span>
          </a>
        </div>

        <!-- 3 Trust Points -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-300 font-medium">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>بدون بطاقة ائتمانية</span>
          </div>
          <span class="text-slate-600 hidden sm:inline">•</span>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>14 يوم مجاناً بالكامل</span>
          </div>
          <span class="text-slate-600 hidden sm:inline">•</span>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>إلغاء في أي وقت</span>
          </div>
        </div>

      </div>

      <!-- Left Column: Enterprise Dashboard SVG Mockup -->
      <div class="lg:col-span-6 relative">
        <div class="relative mx-auto max-w-xl lg:max-w-none rounded-xl overflow-hidden shadow-2xl border border-slate-700/60 bg-[#0F1E33]/90 backdrop-blur-md p-4 sm:p-5">
          
          <!-- Mockup Top Window Chrome -->
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-700/60 text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              <span class="text-[11px] font-mono text-slate-400 mr-2">app.medo-erp.ye/dashboard</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-semibold border border-emerald-500/30">فرع صنعاء الرئيسي</span>
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            </div>
          </div>

          <!-- Top 3 KPI Cards -->
          <div class="grid grid-cols-3 gap-2.5 sm:gap-3 mb-4">
            <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
              <div class="text-[10px] text-slate-400 mb-1">إجمالي المبيعات اليوم</div>
              <div class="text-base sm:text-lg font-bold text-white tracking-tight">842,500 <span class="text-[10px] font-normal text-slate-300">ريال</span></div>
              <div class="text-[10px] text-emerald-400 mt-1 flex items-center gap-0.5">
                <span>↑ 18.4%</span>
                <span class="text-slate-400">مقارنة بأمس</span>
              </div>
            </div>

            <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
              <div class="text-[10px] text-slate-400 mb-1">الفواتير المصدرة</div>
              <div class="text-base sm:text-lg font-bold text-white tracking-tight">142 <span class="text-[10px] font-normal text-slate-300">فاتورة</span></div>
              <div class="text-[10px] text-sky-400 mt-1">مكتملة آلياً</div>
            </div>

            <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
              <div class="text-[10px] text-slate-400 mb-1">رصيد الصندوق والنقدية</div>
              <div class="text-base sm:text-lg font-bold text-sap-gold tracking-tight">3,450,200 <span class="text-[10px] font-normal text-slate-300">ريال</span></div>
              <div class="text-[10px] text-emerald-400 mt-1">مطابق للبنك</div>
            </div>
          </div>

          <!-- Middle Chart Section (SVG Vector Area Graph) -->
          <div class="bg-slate-800/50 p-3.5 rounded-lg border border-slate-700/40 mb-4">
            <div class="flex items-center justify-between mb-3">
              <div class="text-xs font-bold text-white flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-sap-blue"></span>
                <span>تحليل الإيرادات والتدفق النقدي الفوري</span>
              </div>
              <div class="flex items-center gap-2 text-[10px] text-slate-400">
                <span class="px-2 py-0.5 rounded bg-slate-700 text-white font-medium">أسبوعي</span>
                <span>شهري</span>
                <span>سنوي</span>
              </div>
            </div>

            <!-- SVG Visual Chart -->
            <div class="h-36 w-full relative">
              <svg viewBox="0 0 500 140" class="w-full h-full" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0057d2" stop-opacity="0.45" />
                    <stop offset="100%" stop-color="#0057d2" stop-opacity="0.0" />
                  </linearGradient>
                </defs>
                <!-- Chart grid lines -->
                <line x1="0" y1="35" x2="500" y2="35" stroke="#334155" stroke-dasharray="3 3" stroke-width="0.7"/>
                <line x1="0" y1="70" x2="500" y2="70" stroke="#334155" stroke-dasharray="3 3" stroke-width="0.7"/>
                <line x1="0" y1="105" x2="500" y2="105" stroke="#334155" stroke-dasharray="3 3" stroke-width="0.7"/>

                <!-- Fill area -->
                <path d="M 0 110 Q 70 80 130 95 T 260 45 T 380 60 T 500 20 L 500 140 L 0 140 Z" fill="url(#chartGrad)" />
                <!-- Primary Line -->
                <path d="M 0 110 Q 70 80 130 95 T 260 45 T 380 60 T 500 20" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
                <!-- Secondary target line -->
                <path d="M 0 120 Q 90 100 180 85 T 340 75 T 500 50" fill="none" stroke="#d4af37" stroke-width="1.8" stroke-dasharray="4 4" />
                
                <!-- Active Data point -->
                <circle cx="260" cy="45" r="4.5" fill="#38bdf8" stroke="#FFFFFF" stroke-width="2" />
                <circle cx="500" cy="20" r="4.5" fill="#38bdf8" stroke="#FFFFFF" stroke-width="2" />
              </svg>
            </div>
            
            <div class="flex justify-between text-[10px] text-slate-400 mt-1 px-1">
              <span>السبت</span>
              <span>الأحد</span>
              <span>الإثنين</span>
              <span>الثلاثاء</span>
              <span>الأربعاء</span>
              <span>الخميس</span>
              <span>الجمعة</span>
            </div>
          </div>

          <!-- Bottom: Recent Transactions Row -->
          <div class="bg-slate-800/40 rounded-lg p-3 border border-slate-700/40">
            <div class="text-[11px] font-bold text-slate-300 mb-2 flex items-center justify-between">
              <span>آخر الحركات والعمليات المتزامنة</span>
              <span class="text-[10px] text-emerald-400">● مزامنة فورية</span>
            </div>
            <div class="space-y-1.5 text-[11px]">
              <div class="flex items-center justify-between p-1.5 rounded bg-slate-900/40">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span class="text-white font-medium">فاتورة مبيعات #INV-9824</span>
                  <span class="text-slate-400 text-[10px]">مؤسسة الأمل للتجارة</span>
                </div>
                <span class="font-bold text-emerald-300">+125,000 ريال</span>
              </div>
              <div class="flex items-center justify-between p-1.5 rounded bg-slate-900/40">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                  <span class="text-white font-medium">سند قبض #REC-4102</span>
                  <span class="text-slate-400 text-[10px]">شركة الأفق الحديث</span>
                </div>
                <span class="font-bold text-sky-300">+84,000 ريال</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Hero Bottom Stats Banner (4 stats) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-12 border-t border-slate-700/60">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      
      <div class="p-4 rounded-lg bg-white/5 border border-white/10 backdrop-blur-xs">
        <div class="text-3xl sm:text-4xl font-black text-sap-gold mb-1 tracking-tight">+500</div>
        <div class="text-xs sm:text-sm font-semibold text-slate-300">منشأة تثق بنا في اليمن</div>
      </div>

      <div class="p-4 rounded-lg bg-white/5 border border-white/10 backdrop-blur-xs">
        <div class="text-3xl sm:text-4xl font-black text-white mb-1 tracking-tight">+10,000</div>
        <div class="text-xs sm:text-sm font-semibold text-slate-300">فاتورة يومياً عبر السحابة</div>
      </div>

      <div class="p-4 rounded-lg bg-white/5 border border-white/10 backdrop-blur-xs">
        <div class="text-3xl sm:text-4xl font-black text-emerald-400 mb-1 tracking-tight">99.9%</div>
        <div class="text-xs sm:text-sm font-semibold text-slate-300">جاهزية واستقرار السيرفرات</div>
      </div>

      <div class="p-4 rounded-lg bg-white/5 border border-white/10 backdrop-blur-xs">
        <div class="text-3xl sm:text-4xl font-black text-sky-400 mb-1 tracking-tight">24/7</div>
        <div class="text-xs sm:text-sm font-semibold text-slate-300">دعم فني واستشارات مجانية</div>
      </div>

    </div>
  </div>

</section>
