---
---
<section class="relative bg-gradient-to-b from-dark via-navy-light to-navy text-white pt-20 pb-24 overflow-hidden">
  
  <!-- Subtle enterprise background grid pattern (Linear / Vercel Style) -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="ds2-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#FFFFFF" stroke-width="0.8" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#ds2-grid)" />
    </svg>
  </div>

  <!-- Radial Glow Orbs (Stripe / Linear ambient light) -->
  <div class="absolute -top-32 right-1/4 w-[500px] h-[500px] bg-sap/25 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute top-1/2 -left-20 w-[450px] h-[450px] bg-cta/20 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Right Column: Content & Actions -->
      <div class="lg:col-span-6 text-right reveal-on-scroll">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/15 text-blue-300 text-xs font-heading font-bold mb-8 backdrop-blur-md shadow-inner">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>منظومة معتمدة بمعايير SAP العالمية</span>
          <span class="text-white/30">•</span>
          <span class="text-white/80">SaaS Cloud 2.0</span>
        </div>

        <!-- Headline (Tajawal 900, 7xl) -->
        <h1 class="font-heading font-black text-4xl sm:text-6xl lg:text-7xl leading-[1.12] tracking-tight mb-6">
          أدر أعمالك بذكاء،<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38bdf8] via-[#60a5fa] to-white">
            من أي مكان
          </span>
        </h1>

        <!-- Description (IBM Plex, xl) -->
        <p class="font-body text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-10 max-w-xl">
          منظومة MeDo ERP السحابية المتكاملة — فواتير ذكية، نقاط بيع سحابية، إدارة المخزون متعدد الفروع، والتقارير المالية الفورية للمنشآت الرائدة.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a
            href="https://medo-erp-cloud.vercel.app"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-lg bg-cta text-white font-heading font-bold text-base hover:bg-cta-hover hover:scale-105 active:scale-95 shadow-cta-glow transition-all duration-300 text-center flex items-center justify-center gap-2"
          >
            <span>ابدأ التجربة المجانية</span>
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          
          <a
            href="https://wa.me/967773586047?text=مرحباً، أود حجز عرض توضيحي مباشر لمنظومة MeDo ERP"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-lg bg-white/10 hover:bg-white/20 text-white font-heading font-semibold text-base border border-white/20 backdrop-blur-md hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 text-center flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.768-2.587 5.768-5.766.001-3.182-2.585-5.806-5.768-5.806zm0 10.455c-.908 0-1.637-.24-2.341-.663l-.167-.099-1.579.414.421-1.539-.109-.174c-.459-.731-.726-1.554-.725-2.528.001-2.463 2.003-4.465 4.468-4.465 2.463 0 4.466 2.002 4.467 4.465 0 2.464-2.004 4.589-4.435 4.589z"/>
            </svg>
            <span>اطلب عرضاً توضيحياً</span>
          </a>
        </div>

        <!-- 3 Trust Points -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-300 font-body">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>بدون بطاقة ائتمانية</span>
          </div>
          <span class="text-slate-600 hidden sm:inline">•</span>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>14 يوم مجاناً بالكامل</span>
          </div>
          <span class="text-slate-600 hidden sm:inline">•</span>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>إلغاء في أي وقت</span>
          </div>
        </div>

      </div>

      <!-- Left Column: Horizontal Dashboard SVG Mockup -->
      <div class="lg:col-span-6 relative reveal-on-scroll">
        <div class="relative mx-auto max-w-xl lg:max-w-none rounded-2xl overflow-hidden shadow-2xl border border-white/15 bg-[#0B1E38]/90 backdrop-blur-xl p-5 hover:border-cta/40 transition-colors duration-500">
          
          <!-- Mockup Top Window Header -->
          <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-white/10 text-xs text-slate-400 font-mono">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              <span class="text-[11px] text-slate-300 mr-2">app.medo-erp.ye/live</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 text-[10px] font-semibold border border-emerald-500/30">فرع صنعاء • متزامن</span>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            </div>
          </div>

          <!-- Top 3 Metrics -->
          <div class="grid grid-cols-3 gap-3 mb-4">
            <div class="bg-white/5 p-3 rounded-xl border border-white/10">
              <div class="text-[10px] text-slate-400 mb-1">المبيعات اليومية</div>
              <div class="text-base sm:text-lg font-mono-num font-bold text-white tracking-tight">842,500 <span class="text-[10px] text-slate-400 font-body">ريال</span></div>
              <div class="text-[10px] text-emerald-400 mt-1">↑ 18.4% نمو</div>
            </div>

            <div class="bg-white/5 p-3 rounded-xl border border-white/10">
              <div class="text-[10px] text-slate-400 mb-1">الفواتير المرحلة</div>
              <div class="text-base sm:text-lg font-mono-num font-bold text-white tracking-tight">142 <span class="text-[10px] text-slate-400 font-body">فاتورة</span></div>
              <div class="text-[10px] text-sky-400 mt-1">آلية بنسبة 100%</div>
            </div>

            <div class="bg-white/5 p-3 rounded-xl border border-white/10">
              <div class="text-[10px] text-slate-400 mb-1">النقدية والبنوك</div>
              <div class="text-base sm:text-lg font-mono-num font-bold text-gold tracking-tight">3,450,200 <span class="text-[10px] text-slate-400 font-body">ريال</span></div>
              <div class="text-[10px] text-emerald-400 mt-1">مطابق لحظياً</div>
            </div>
          </div>

          <!-- Horizontal Vector Area Graph (SVG) -->
          <div class="bg-white/[0.03] p-4 rounded-xl border border-white/10 mb-4">
            <div class="flex items-center justify-between mb-3">
              <div class="text-xs font-heading font-bold text-white flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-cta"></span>
                <span>مؤشر التدفق النقدي والإيرادات التراكمية</span>
              </div>
              <div class="flex items-center gap-2 text-[10px] font-body text-slate-400">
                <span class="px-2 py-0.5 rounded bg-white/15 text-white font-semibold">أسبوعي</span>
                <span>شهري</span>
                <span>سنوي</span>
              </div>
            </div>

            <div class="h-40 w-full relative">
              <svg viewBox="0 0 500 150" class="w-full h-full" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="heroGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0070F3" stop-opacity="0.5" />
                    <stop offset="100%" stop-color="#0070F3" stop-opacity="0.0" />
                  </linearGradient>
                </defs>
                
                <!-- Grid Lines -->
                <line x1="0" y1="35" x2="500" y2="35" stroke="#1E293B" stroke-dasharray="3 3" stroke-width="0.8" />
                <line x1="0" y1="75" x2="500" y2="75" stroke="#1E293B" stroke-dasharray="3 3" stroke-width="0.8" />
                <line x1="0" y1="115" x2="500" y2="115" stroke="#1E293B" stroke-dasharray="3 3" stroke-width="0.8" />

                <!-- Gradient Fill Area -->
                <path d="M 0 115 Q 70 85 140 100 T 280 40 T 400 55 T 500 18 L 500 150 L 0 150 Z" fill="url(#heroGradient)" />
                <!-- Primary Curve Line -->
                <path d="M 0 115 Q 70 85 140 100 T 280 40 T 400 55 T 500 18" fill="none" stroke="#38BDF8" stroke-width="3" stroke-linecap="round" />
                <!-- Secondary Baseline -->
                <path d="M 0 130 Q 90 110 190 90 T 350 75 T 500 48" fill="none" stroke="#C9A227" stroke-width="1.8" stroke-dasharray="4 4" />

                <!-- Glowing Data Dots -->
                <circle cx="280" cy="40" r="5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="2" />
                <circle cx="500" cy="18" r="5.5" fill="#0070F3" stroke="#FFFFFF" stroke-width="2.5" />
              </svg>
            </div>

            <div class="flex justify-between text-[10px] font-mono text-slate-400 mt-2 px-1">
              <span>السبت</span>
              <span>الأحد</span>
              <span>الإثنين</span>
              <span>الثلاثاء</span>
              <span>الأربعاء</span>
              <span>الخميس</span>
              <span>الجمعة</span>
            </div>
          </div>

          <!-- Bottom Live Transaction Chips -->
          <div class="grid grid-cols-2 gap-2 text-[11px] font-body">
            <div class="p-2.5 rounded-lg bg-white/5 border border-white/10 flex items-center justify-between">
              <span class="text-slate-300">فاتورة نقدية #9842</span>
              <span class="font-mono-num font-bold text-emerald-400">+125,000 ريال</span>
            </div>
            <div class="p-2.5 rounded-lg bg-white/5 border border-white/10 flex items-center justify-between">
              <span class="text-slate-300">سند قبض #4102</span>
              <span class="font-mono-num font-bold text-sky-400">+84,000 ريال</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

</section>
