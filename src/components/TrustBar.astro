---
---
<section class="bg-ivory py-16 border-y border-gray-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-on-scroll">
    
    <p class="font-heading text-xs sm:text-sm font-bold text-gray-text uppercase tracking-widest mb-8">
      موثوق به من قبل رواد الأعمال والشركات الرائدة في اليمن
    </p>

    <!-- 5 Client Cards (Linear / Stripe Style Grid) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 items-center">
      
      <!-- Logo 1: مجموعة بن زياد -->
      <div class="group bg-white p-4 sm:p-5 rounded-xl border border-gray-200/80 hover:border-sap hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-navy text-white flex items-center justify-center font-heading font-black text-sm group-hover:bg-sap transition-colors">
          BZ
        </div>
        <div class="text-right">
          <div class="text-sm font-heading font-bold text-navy group-hover:text-sap transition-colors">مجموعة بن زياد</div>
          <div class="text-[10px] text-gray-text font-body">للتجارة والاستثمار</div>
        </div>
      </div>

      <!-- Logo 2: المصنع الحديث -->
      <div class="group bg-white p-4 sm:p-5 rounded-xl border border-gray-200/80 hover:border-sap hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-50 text-sap flex items-center justify-center text-lg group-hover:bg-sap group-hover:text-white transition-all">
          🏭
        </div>
        <div class="text-right">
          <div class="text-sm font-heading font-bold text-navy group-hover:text-sap transition-colors">المصنع الحديث</div>
          <div class="text-[10px] text-gray-text font-body">للصناعات الوطنية</div>
        </div>
      </div>

      <!-- Logo 3: النهج الأخير -->
      <div class="group bg-white p-4 sm:p-5 rounded-xl border border-gray-200/80 hover:border-sap hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-heading font-black text-sm group-hover:bg-sap group-hover:text-white transition-all">
          NL
        </div>
        <div class="text-right">
          <div class="text-sm font-heading font-bold text-navy group-hover:text-sap transition-colors">النهج الأخير</div>
          <div class="text-[10px] text-gray-text font-body">سلاسل التوريد والخدمات</div>
        </div>
      </div>

      <!-- Logo 4: مجموعة الرواد -->
      <div class="group bg-white p-4 sm:p-5 rounded-xl border border-gray-200/80 hover:border-sap hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center text-lg group-hover:bg-sap group-hover:text-white transition-all">
          🏠
        </div>
        <div class="text-right">
          <div class="text-sm font-heading font-bold text-navy group-hover:text-sap transition-colors">مجموعة الرواد</div>
          <div class="text-[10px] text-gray-text font-body">للمقاولات والتوريد</div>
        </div>
      </div>

      <!-- Logo 5: صيدليات الأندلس -->
      <div class="group bg-white p-4 sm:p-5 rounded-xl border border-gray-200/80 hover:border-sap hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3 col-span-2 sm:col-span-1">
        <div class="w-10 h-10 rounded-lg bg-sky-50 text-sky-700 flex items-center justify-center font-heading font-black text-lg group-hover:bg-sap group-hover:text-white transition-all">
          +
        </div>
        <div class="text-right">
          <div class="text-sm font-heading font-bold text-navy group-hover:text-sap transition-colors">صيدليات الأندلس</div>
          <div class="text-[10px] text-gray-text font-body">شبكة الفروع الطبية</div>
        </div>
      </div>

    </div>

  </div>
</section>
