---
---
<section class="bg-sap-gray py-12 border-y border-sap-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <p class="text-xs sm:text-sm font-bold text-sap-muted uppercase tracking-wider mb-8">
      موثوق به من قبل رواد الأعمال والشركات الرائدة في اليمن
    </p>

    <!-- 5 Client Logos (SVG Vector Logos) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 sm:gap-8 items-center justify-items-center opacity-85 hover:opacity-100 transition-opacity">
      
      <!-- Client 1: مجموعة بن زياد -->
      <div class="flex items-center gap-2.5 p-3 rounded-lg hover:bg-white hover:shadow-subtle transition">
        <div class="w-9 h-9 rounded bg-sap-dark text-white flex items-center justify-center font-bold text-sm shadow-xs">
          BZ
        </div>
        <div class="text-right">
          <div class="text-sm font-black text-sap-text leading-tight">مجموعة بن زياد</div>
          <div class="text-[10px] text-sap-muted">للتجارة والاستثمار</div>
        </div>
      </div>

      <!-- Client 2: المصنع الحديث الوطني -->
      <div class="flex items-center gap-2.5 p-3 rounded-lg hover:bg-white hover:shadow-subtle transition">
        <div class="w-9 h-9 rounded bg-sap-blue text-white flex items-center justify-center font-bold text-sm shadow-xs">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div class="text-right">
          <div class="text-sm font-black text-sap-text leading-tight">المصنع الحديث</div>
          <div class="text-[10px] text-sap-muted">للصناعات الوطنية</div>
        </div>
      </div>

      <!-- Client 3: شركة النهج الأخير -->
      <div class="flex items-center gap-2.5 p-3 rounded-lg hover:bg-white hover:shadow-subtle transition">
        <div class="w-9 h-9 rounded bg-[#107C41] text-white flex items-center justify-center font-bold text-sm shadow-xs">
          NL
        </div>
        <div class="text-right">
          <div class="text-sm font-black text-sap-text leading-tight">النهج الأخير</div>
          <div class="text-[10px] text-sap-muted">سلاسل التوريد واللوجستيات</div>
        </div>
      </div>

      <!-- Client 4: شركة الرواد للمقاولات والتجارة -->
      <div class="flex items-center gap-2.5 p-3 rounded-lg hover:bg-white hover:shadow-subtle transition">
        <div class="w-9 h-9 rounded bg-[#C05621] text-white flex items-center justify-center font-bold text-sm shadow-xs">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </div>
        <div class="text-right">
          <div class="text-sm font-black text-sap-text leading-tight">مجموعة الرواد</div>
          <div class="text-[10px] text-sap-muted">للمقاولات والتوريدات</div>
        </div>
      </div>

      <!-- Client 5: صيدليات الأندلس المركزية -->
      <div class="flex items-center gap-2.5 p-3 rounded-lg hover:bg-white hover:shadow-subtle transition col-span-2 sm:col-span-1">
        <div class="w-9 h-9 rounded bg-[#0284C7] text-white flex items-center justify-center font-bold text-sm shadow-xs">
          +
        </div>
        <div class="text-right">
          <div class="text-sm font-black text-sap-text leading-tight">صيدليات الأندلس</div>
          <div class="text-[10px] text-sap-muted">شبكة الفروع الطبية</div>
        </div>
      </div>

    </div>

  </div>
</section>
