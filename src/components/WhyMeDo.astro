---
---
<section id="why-medo" class="py-24 bg-sap-gray border-y border-sap-border relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Right Column: Visual SVG Graph of Growth & Profit -->
      <div class="lg:col-span-6 order-2 lg:order-1">
        <div class="bg-white p-6 sm:p-8 rounded-xl border border-sap-border shadow-sap-card relative overflow-hidden">
          
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-gray-100">
            <div>
              <span class="text-xs font-bold text-sap-blue uppercase tracking-wider">مؤشر نمو الكفاءة والأرباح</span>
              <h4 class="text-lg font-black text-sap-dark mt-0.5">مقارنة الأداء: قبل وبعد MeDo ERP</h4>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">+64% نمو الكفاءة</span>
          </div>

          <!-- Infographic Vector Chart -->
          <div class="w-full h-64 relative mb-6">
            <svg viewBox="0 0 450 200" class="w-full h-full" preserveAspectRatio="none">
              <defs>
                <linearGradient id="profitGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0057d2" stop-opacity="0.3" />
                  <stop offset="100%" stop-color="#0057d2" stop-opacity="0.0" />
                </linearGradient>
                <linearGradient id="legacyGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#cbd5e1" stop-opacity="0.2" />
                  <stop offset="100%" stop-color="#cbd5e1" stop-opacity="0.0" />
                </linearGradient>
              </defs>

              <!-- Chart Background Lines -->
              <line x1="0" y1="40" x2="450" y2="40" stroke="#f1f5f9" stroke-width="1.5" />
              <line x1="0" y1="90" x2="450" y2="90" stroke="#f1f5f9" stroke-width="1.5" />
              <line x1="0" y1="140" x2="450" y2="140" stroke="#f1f5f9" stroke-width="1.5" />

              <!-- Legacy System Path (Grey Flat line) -->
              <path d="M 0 150 Q 120 145 220 140 T 450 135 L 450 190 L 0 190 Z" fill="url(#legacyGrad)" />
              <path d="M 0 150 Q 120 145 220 140 T 450 135" fill="none" stroke="#94a3b8" stroke-width="2.5" stroke-dasharray="4 4" />

              <!-- MeDo ERP Growth Path (Sharp Blue Curve) -->
              <path d="M 0 160 Q 100 130 200 90 T 360 40 T 450 25 L 450 190 L 0 190 Z" fill="url(#profitGrad)" />
              <path d="M 0 160 Q 100 130 200 90 T 360 40 T 450 25" fill="none" stroke="#0057d2" stroke-width="4" stroke-linecap="round" />

              <!-- Peak Indicator -->
              <circle cx="450" cy="25" r="6" fill="#0057d2" stroke="#FFFFFF" stroke-width="3" />
              <circle cx="200" cy="90" r="5" fill="#0057d2" stroke="#FFFFFF" stroke-width="2" />
            </svg>
          </div>

          <!-- Chart legend and micro stats -->
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-100 text-xs">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-sap-blue"></span>
              <span class="text-sap-text font-bold">مع MeDo ERP: نمو مستمر وسرعة فائقة</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-slate-400"></span>
              <span class="text-sap-muted">الأنظمة التقليدية القديمة: تكلفة وبطء</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Left Column: The 3 Core Benefits -->
      <div class="lg:col-span-6 order-1 lg:order-2 text-right">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-sap-blue text-xs font-bold mb-4 border border-blue-200">
          <span>الكفاءة المؤسسية</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-black text-sap-dark tracking-tight mb-6">
          لماذا تختار الشركات الرائدة MeDo ERP؟
        </h2>
        
        <p class="text-base text-sap-muted leading-relaxed mb-8">
          صُممت المنظومة لتتجاوز التحديات المعقدة لبيئة الأعمال المحلية، وتوفر لك تجربة قيادة مؤسسية مطابقة لأعلى المعايير العالمية.
        </p>

        <!-- 3 Advantages -->
        <div class="space-y-6">
          
          <!-- Advantage 1 -->
          <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-sap-border hover:border-sap-blue transition-all shadow-xs">
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center shrink-0 font-bold text-xl">
              ⚡
            </div>
            <div>
              <h3 class="text-lg font-bold text-sap-dark mb-1">
                توفير 40% من وقت المحاسبة
              </h3>
              <p class="text-sm text-sap-muted leading-relaxed">
                أتمتة كاملة لإصدار الفواتير، الترحيل الآلي للقيود المحاسبية، وتحديث أرصدة المخازن فور كل حركة بيع دون جهد يدوي مكرر.
              </p>
            </div>
          </div>

          <!-- Advantage 2 -->
          <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-sap-border hover:border-sap-blue transition-all shadow-xs">
            <div class="w-12 h-12 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-xl">
              ✓
            </div>
            <div>
              <h3 class="text-lg font-bold text-sap-dark mb-1">
                دقة 100% في الحسابات والأرصدة
              </h3>
              <p class="text-sm text-sap-muted leading-relaxed">
                معادلات حسابية دقيقة تعالج فروق أسعار الصرف المتغيرة في اليمن مع تسوية فورية للصناديق والبنوك وكشوفات العملاء.
              </p>
            </div>
          </div>

          <!-- Advantage 3 -->
          <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-sap-border hover:border-sap-blue transition-all shadow-xs">
            <div class="w-12 h-12 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 font-bold text-xl">
              📊
            </div>
            <div>
              <h3 class="text-lg font-bold text-sap-dark mb-1">
                تقارير فورية في أي وقت ومن أي جهاز
              </h3>
              <p class="text-sm text-sap-muted leading-relaxed">
                لوحات تحكم ذكية تعرض مؤشرات الأرباح، دوران المخزون، والديون المعدومة لمتخذي القرار بضغطة زر دون انتظار نهاية الشهر.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
