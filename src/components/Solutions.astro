---
---
<section id="solutions" class="py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-sap-blue text-xs font-bold mb-4 border border-blue-200">
        <span>باقة البرمجيات المؤسسية</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-sap-dark tracking-tight mb-4">
        حلول شاملة ومتكاملة
      </h2>
      <p class="text-base sm:text-lg text-sap-muted leading-relaxed">
        صممت موديولات MeDo ERP وفق أفضل ممارسات هندسة البرمجيات العالمية لتوحيد أعمالك المحاسبية والإدارية في منصة سحابية واحدة فائقة السرعة.
      </p>
    </div>

    <!-- 6 SAP Fiori Style Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Card 01: الفوترة والامتثال -->
      <div class="group relative bg-white p-8 rounded-lg border border-sap-border hover:border-sap-blue transition-all duration-300 hover:-translate-y-1.5 hover:shadow-sap-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-black text-slate-300 group-hover:text-sap-blue transition-colors font-mono">01</span>
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center group-hover:bg-sap-blue group-hover:text-white transition-all duration-300 shadow-xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-sap-dark mb-3 group-hover:text-sap-blue transition-colors">
            الفوترة الذكية والامتثال
          </h3>
          <p class="text-sap-muted text-sm leading-relaxed mb-6">
            إصدار فواتير بيع وشراء نقدية وآجلة في أجزاء من الثانية مع دعم الباركود المباشر، السداد المتعدد، وتوافق تام مع المعايير المحاسبية.
          </p>
        </div>
        <a href="#pricing" class="inline-flex items-center gap-1.5 text-sm font-bold text-sap-blue group-hover:text-sap-blue-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 02: إدارة المخزون -->
      <div class="group relative bg-white p-8 rounded-lg border border-sap-border hover:border-sap-blue transition-all duration-300 hover:-translate-y-1.5 hover:shadow-sap-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-black text-slate-300 group-hover:text-sap-blue transition-colors font-mono">02</span>
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center group-hover:bg-sap-blue group-hover:text-white transition-all duration-300 shadow-xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-sap-dark mb-3 group-hover:text-sap-blue transition-colors">
            إدارة المخزون والمستودعات
          </h3>
          <p class="text-sap-muted text-sm leading-relaxed mb-6">
            تتبع دقيق لأرصدة الأصناف عبر مستودعات متعددة، تنبيهات حد الطلب، وإدارة تواريخ الصلاحية والجرد الدوري دون إيقاف المبيعات.
          </p>
        </div>
        <a href="#pricing" class="inline-flex items-center gap-1.5 text-sm font-bold text-sap-blue group-hover:text-sap-blue-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 03: نقاط البيع السريعة -->
      <div class="group relative bg-white p-8 rounded-lg border border-sap-border hover:border-sap-blue transition-all duration-300 hover:-translate-y-1.5 hover:shadow-sap-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-black text-slate-300 group-hover:text-sap-blue transition-colors font-mono">03</span>
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center group-hover:bg-sap-blue group-hover:text-white transition-all duration-300 shadow-xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-sap-dark mb-3 group-hover:text-sap-blue transition-colors">
            نقاط البيع السحابية (POS)
          </h3>
          <p class="text-sap-muted text-sm leading-relaxed mb-6">
            واجهة كاشير لمسية خفيفة وسريعة، تعمل بكفاءة حتى عند انقطاع الإنترنت، مع مزامنة لحظية فور استعادة الاتصال.
          </p>
        </div>
        <a href="#pricing" class="inline-flex items-center gap-1.5 text-sm font-bold text-sap-blue group-hover:text-sap-blue-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 04: الإدارة المالية والتقارير -->
      <div class="group relative bg-white p-8 rounded-lg border border-sap-border hover:border-sap-blue transition-all duration-300 hover:-translate-y-1.5 hover:shadow-sap-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-black text-slate-300 group-hover:text-sap-blue transition-colors font-mono">04</span>
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center group-hover:bg-sap-blue group-hover:text-white transition-all duration-300 shadow-xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-sap-dark mb-3 group-hover:text-sap-blue transition-colors">
            التقارير والمحاسبة المالية
          </h3>
          <p class="text-sap-muted text-sm leading-relaxed mb-6">
            دفتر الأستاذ العام، ميزان المراجعة، الأرباح والخسائر، والميزانية العمومية بضغطة زر مع دعم القيود اليومية التلقائية.
          </p>
        </div>
        <a href="#pricing" class="inline-flex items-center gap-1.5 text-sm font-bold text-sap-blue group-hover:text-sap-blue-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 05: متعدد الفروع والعملات -->
      <div class="group relative bg-white p-8 rounded-lg border border-sap-border hover:border-sap-blue transition-all duration-300 hover:-translate-y-1.5 hover:shadow-sap-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-black text-slate-300 group-hover:text-sap-blue transition-colors font-mono">05</span>
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center group-hover:bg-sap-blue group-hover:text-white transition-all duration-300 shadow-xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-sap-dark mb-3 group-hover:text-sap-blue transition-colors">
            تعدد الفروع وأسعار الصرف
          </h3>
          <p class="text-sap-muted text-sm leading-relaxed mb-6">
            ربط موحد لفروع صنعاء، عدن، وباقي المحافظات مع معالجة احترافية لتفاوت أسعار الصرف (ريال قديم، جديد، دولار، وسعودي).
          </p>
        </div>
        <a href="#pricing" class="inline-flex items-center gap-1.5 text-sm font-bold text-sap-blue group-hover:text-sap-blue-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 06: علاقات العملاء والموردين -->
      <div class="group relative bg-white p-8 rounded-lg border border-sap-border hover:border-sap-blue transition-all duration-300 hover:-translate-y-1.5 hover:shadow-sap-hover flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-black text-slate-300 group-hover:text-sap-blue transition-colors font-mono">06</span>
            <div class="w-12 h-12 rounded-lg bg-blue-50 text-sap-blue flex items-center justify-center group-hover:bg-sap-blue group-hover:text-white transition-all duration-300 shadow-xs">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-sap-dark mb-3 group-hover:text-sap-blue transition-colors">
            علاقات العملاء وإدارة الذمم
          </h3>
          <p class="text-sap-muted text-sm leading-relaxed mb-6">
            ملفات تفصيلية لكل عميل ومورد، كشوفات حساب دقيقة، حدود الائتمان، وتنبيهات مواعيد تحصيل الديون المستحقة.
          </p>
        </div>
        <a href="#pricing" class="inline-flex items-center gap-1.5 text-sm font-bold text-sap-blue group-hover:text-sap-blue-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>
