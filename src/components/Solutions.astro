---
---
<section id="solutions" class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-sap text-xs font-heading font-bold mb-4 border border-blue-200">
        <span>منظومة برمجية متكاملة</span>
      </div>
      <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-navy tracking-tight mb-4">
        حلول شاملة ومتكاملة
      </h2>
      <p class="font-body text-base sm:text-lg text-gray-text leading-relaxed">
        صممت موديولات MeDo ERP وفق أحدث أطر هندسة البرمجيات لتمنحك تحكماً مركزياً فائق الدقة في كافة جوانب مؤسستك.
      </p>
    </div>

    <!-- 6 Cards Grid (3x2) with Large Watermark Numbers -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Card 01: الفوترة -->
      <div class="group relative bg-white p-8 rounded-2xl border border-gray-200 hover:border-sap transition-all duration-300 hover:-translate-y-1 hover:shadow-sap-hover flex flex-col justify-between overflow-hidden reveal-on-scroll">
        <!-- Watermark Number -->
        <span class="absolute -bottom-4 -left-3 font-mono-num font-black text-8xl text-gray-100/90 select-none pointer-events-none group-hover:text-blue-50 transition-colors">
          01
        </span>

        <div class="relative z-10">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-sap flex items-center justify-center mb-6 group-hover:bg-sap group-hover:text-white transition-all duration-300 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors">
            الفوترة الذكية والامتثال
          </h3>
          <p class="font-body text-sm text-gray-text leading-relaxed mb-6">
            إصدار فواتير بيع وشراء فورية متوافقة محاسبياً، مع قراءة سريعة للباركود، وإدارة السداد النقدي والآجل في ثوانٍ.
          </p>
        </div>

        <a href="#pricing" class="relative z-10 inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 02: إدارة المخزون -->
      <div class="group relative bg-white p-8 rounded-2xl border border-gray-200 hover:border-sap transition-all duration-300 hover:-translate-y-1 hover:shadow-sap-hover flex flex-col justify-between overflow-hidden reveal-on-scroll">
        <span class="absolute -bottom-4 -left-3 font-mono-num font-black text-8xl text-gray-100/90 select-none pointer-events-none group-hover:text-blue-50 transition-colors">
          02
        </span>

        <div class="relative z-10">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-sap flex items-center justify-center mb-6 group-hover:bg-sap group-hover:text-white transition-all duration-300 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors">
            إدارة المخزون والمستودعات
          </h3>
          <p class="font-body text-sm text-gray-text leading-relaxed mb-6">
            متابعة أرصدة الأصناف عبر مستودعات وفروع متعددة، تنبيهات آلية عند وصول حد الطلب، وإدارة تواريخ الصلاحية والجرد الدوري.
          </p>
        </div>

        <a href="#pricing" class="relative z-10 inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 03: نقاط البيع -->
      <div class="group relative bg-white p-8 rounded-2xl border border-gray-200 hover:border-sap transition-all duration-300 hover:-translate-y-1 hover:shadow-sap-hover flex flex-col justify-between overflow-hidden reveal-on-scroll">
        <span class="absolute -bottom-4 -left-3 font-mono-num font-black text-8xl text-gray-100/90 select-none pointer-events-none group-hover:text-blue-50 transition-colors">
          03
        </span>

        <div class="relative z-10">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-sap flex items-center justify-center mb-6 group-hover:bg-sap group-hover:text-white transition-all duration-300 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors">
            نقاط البيع السحابية (POS)
          </h3>
          <p class="font-body text-sm text-gray-text leading-relaxed mb-6">
            واجهة كاشير لمسية سهلة وسريعة تعمل بدون إنترنت (Offline-First) مع مزامنة مركزية فور عودة الاتصال دون توقف البيع.
          </p>
        </div>

        <a href="#pricing" class="relative z-10 inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 04: التقارير المالية -->
      <div class="group relative bg-white p-8 rounded-2xl border border-gray-200 hover:border-sap transition-all duration-300 hover:-translate-y-1 hover:shadow-sap-hover flex flex-col justify-between overflow-hidden reveal-on-scroll">
        <span class="absolute -bottom-4 -left-3 font-mono-num font-black text-8xl text-gray-100/90 select-none pointer-events-none group-hover:text-blue-50 transition-colors">
          04
        </span>

        <div class="relative z-10">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-sap flex items-center justify-center mb-6 group-hover:bg-sap group-hover:text-white transition-all duration-300 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors">
            المحاسبة والتقارير التنفيذية
          </h3>
          <p class="font-body text-sm text-gray-text leading-relaxed mb-6">
            شجرة حسابات مرنة، دفتر أستاذ عام، ميزان مراجعة، وقائمة دخل وميزانية عمومية لحظية لمتخذي القرار بضغطة زر واحدة.
          </p>
        </div>

        <a href="#pricing" class="relative z-10 inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 05: الفروع والعملات -->
      <div class="group relative bg-white p-8 rounded-2xl border border-gray-200 hover:border-sap transition-all duration-300 hover:-translate-y-1 hover:shadow-sap-hover flex flex-col justify-between overflow-hidden reveal-on-scroll">
        <span class="absolute -bottom-4 -left-3 font-mono-num font-black text-8xl text-gray-100/90 select-none pointer-events-none group-hover:text-blue-50 transition-colors">
          05
        </span>

        <div class="relative z-10">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-sap flex items-center justify-center mb-6 group-hover:bg-sap group-hover:text-white transition-all duration-300 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors">
            تعدد الفروع وأسعار الصرف
          </h3>
          <p class="font-body text-sm text-gray-text leading-relaxed mb-6">
            ربط موحد لفروع صنعاء، عدن، وباقي المحافظات مع معالجة ذكية ودقيقة لتفاوت أسعار العملات وفروق الصرف اليومية تلقائياً.
          </p>
        </div>

        <a href="#pricing" class="relative z-10 inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 06: الموارد البشرية والرواتب -->
      <div class="group relative bg-white p-8 rounded-2xl border border-gray-200 hover:border-sap transition-all duration-300 hover:-translate-y-1 hover:shadow-sap-hover flex flex-col justify-between overflow-hidden reveal-on-scroll">
        <span class="absolute -bottom-4 -left-3 font-mono-num font-black text-8xl text-gray-100/90 select-none pointer-events-none group-hover:text-blue-50 transition-colors">
          06
        </span>

        <div class="relative z-10">
          <div class="w-14 h-14 rounded-xl bg-blue-50 text-sap flex items-center justify-center mb-6 group-hover:bg-sap group-hover:text-white transition-all duration-300 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-xl text-navy mb-3 group-hover:text-sap transition-colors">
            الموارد البشرية وشؤون الموظفين
          </h3>
          <p class="font-body text-sm text-gray-text leading-relaxed mb-6">
            مسير الرواتب الآلي، السلف والخصميات، متابعة الإجازات، وتوليد كشوفات مستحقات الموظفين مع أرشفة السجلات الرقمية.
          </p>
        </div>

        <a href="#pricing" class="relative z-10 inline-flex items-center gap-1.5 text-sm font-heading font-bold text-sap group-hover:text-sap-hover">
          <span>اكتشف المزيد</span>
          <svg class="w-4 h-4 rtl:rotate-180 group-hover:-translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

  </div>
</section>
