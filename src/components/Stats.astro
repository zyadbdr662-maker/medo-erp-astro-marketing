---
---
<section class="py-24 bg-dark text-white relative overflow-hidden">
  
  <!-- Subtle ambient glow lines -->
  <div class="absolute inset-0 opacity-15 pointer-events-none">
    <div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-sap/30 blur-3xl"></div>
    <div class="absolute -left-24 -bottom-24 w-96 h-96 rounded-full bg-gold/20 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <span class="font-heading text-xs font-bold text-gold uppercase tracking-widest">أرقام قياسية موثقة</span>
      <h2 class="font-heading font-black text-3xl sm:text-4xl text-white mt-2 tracking-tight">
        بنية تحتية تدير معاملات التجارة باقتدار
      </h2>
    </div>

    <!-- 4 Massive Golden Numbers -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      
      <!-- Stat 1 -->
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-gold/50 transition-all duration-300 hover:scale-[1.02] reveal-on-scroll">
        <div class="font-mono-num font-bold text-5xl sm:text-6xl text-gold mb-3 tracking-tight">
          +500
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-1">منشأة تثق بنا</h3>
        <p class="font-body text-xs text-slate-300">في مختلف المحافظات والقطاعات التجارية</p>
      </div>

      <!-- Stat 2 -->
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-gold/50 transition-all duration-300 hover:scale-[1.02] reveal-on-scroll">
        <div class="font-mono-num font-bold text-5xl sm:text-6xl text-gold mb-3 tracking-tight">
          +50,000
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-1">فاتورة شهرياً</h3>
        <p class="font-body text-xs text-slate-300">معالجة فورية وترحيل آلي للقيود دون تأخير</p>
      </div>

      <!-- Stat 3 -->
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-gold/50 transition-all duration-300 hover:scale-[1.02] reveal-on-scroll">
        <div class="font-mono-num font-bold text-5xl sm:text-6xl text-gold mb-3 tracking-tight">
          +1,000
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-1">مستخدم نشط</h3>
        <p class="font-body text-xs text-slate-300">محاسبون، أمناء مستودعات، وكاشير يومياً</p>
      </div>

      <!-- Stat 4 -->
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-gold/50 transition-all duration-300 hover:scale-[1.02] reveal-on-scroll">
        <div class="font-mono-num font-bold text-5xl sm:text-6xl text-gold mb-3 tracking-tight">
          99.9%
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-1">وقت تشغيل</h3>
        <p class="font-body text-xs text-slate-300">خوادم موزعة مع نسخ احتياطي دوري كل ساعة</p>
      </div>

    </div>

  </div>
</section>
