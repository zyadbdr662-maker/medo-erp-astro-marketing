---
---
<section class="py-20 bg-sap-dark text-white relative overflow-hidden">
  
  <!-- Subtle enterprise background geometry -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full border border-blue-400"></div>
    <div class="absolute -left-20 -bottom-20 w-96 h-96 rounded-full border border-sap-gold"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold text-sap-gold uppercase tracking-widest">أرقام تتحدث عن جدارتنا</span>
      <h2 class="text-3xl sm:text-4xl font-black text-white mt-2">
        بنية سحابية تحتضن نجاح مئات الأعمال يومياً
      </h2>
    </div>

    <!-- 4 Massive Numbers Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      
      <!-- Stat 1 -->
      <div class="p-6 rounded-xl bg-white/5 border border-white/10 hover:border-sap-gold/50 transition-all duration-300">
        <div class="text-5xl sm:text-6xl font-black text-sap-gold mb-3 font-mono tracking-tight">
          +500
        </div>
        <h3 class="text-lg font-bold text-white mb-1">منشأة تجارية وصناعية</h3>
        <p class="text-xs text-slate-300">تعتمد على MeDo ERP في إدارة عملياتها اليومية</p>
      </div>

      <!-- Stat 2 -->
      <div class="p-6 rounded-xl bg-white/5 border border-white/10 hover:border-sap-gold/50 transition-all duration-300">
        <div class="text-5xl sm:text-6xl font-black text-sap-gold mb-3 font-mono tracking-tight">
          +50,000
        </div>
        <h3 class="text-lg font-bold text-white mb-1">فاتورة شهرياً</h3>
        <p class="text-xs text-slate-300">تتم معالجتها وترحيلها محاسبياً دون تأخير</p>
      </div>

      <!-- Stat 3 -->
      <div class="p-6 rounded-xl bg-white/5 border border-white/10 hover:border-sap-gold/50 transition-all duration-300">
        <div class="text-5xl sm:text-6xl font-black text-sap-gold mb-3 font-mono tracking-tight">
          +1,000
        </div>
        <h3 class="text-lg font-bold text-white mb-1">مستخدم نشط يومياً</h3>
        <p class="text-xs text-slate-300">من مديري حسابات وكاشير ومسؤولي مستودعات</p>
      </div>

      <!-- Stat 4 -->
      <div class="p-6 rounded-xl bg-white/5 border border-white/10 hover:border-sap-gold/50 transition-all duration-300">
        <div class="text-5xl sm:text-6xl font-black text-sap-gold mb-3 font-mono tracking-tight">
          99.9%
        </div>
        <h3 class="text-lg font-bold text-white mb-1">وقت تشغيل وموثوقية</h3>
        <p class="text-xs text-slate-300">خوادم سحابية فائقة السرعة مع نسخ احتياطي دوري</p>
      </div>

    </div>

  </div>
</section>
