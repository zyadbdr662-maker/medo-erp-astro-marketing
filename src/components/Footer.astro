---
const currentYear = new Date().getFullYear();
---
<footer id="contact" class="bg-[#0A192F] text-slate-300 pt-20 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 6 Columns Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10 mb-16">
      
      <!-- Column 1: Brand & Bio & Socials -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-lg bg-sap-blue flex items-center justify-center text-white font-black text-xl shadow-sm">
            M
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-black text-white">MeDo</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-900/60 text-blue-300 border border-blue-700/50">ERP SaaS</span>
            </div>
            <p class="text-[11px] text-slate-400">سحابي بمعايير SAP العالمية</p>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          المنظومة المحاسبية والإدارية السحابية الأكثر تكاملاً في اليمن، تقدم حلول تخطيط الموارد بمعايير عالمية تناسب الشركات الطموحة والمؤسسات الحديثة.
        </p>

        <!-- Contact Micro Information -->
        <div class="space-y-2 text-xs text-slate-300 pt-2">
          <div class="flex items-center gap-2">
            <span class="text-sap-blue">📍</span>
            <span>صنعاء: شارع حدة | عدن: المنصورة، الشارع العام</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sap-blue">📞</span>
            <span dir="ltr" class="font-mono">+967 773 586 047</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sap-blue">✉️</span>
            <span class="font-mono">support@medo-erp.ye</span>
          </div>
        </div>

        <!-- Social Media Icons (SVGs) -->
        <div class="flex items-center gap-3 pt-2">
          <!-- WhatsApp -->
          <a href="https://wa.me/967773586047" target="_blank" rel="noopener noreferrer" aria-label="واتساب" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-300 hover:bg-emerald-600 hover:text-white transition flex items-center justify-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.768-2.587 5.768-5.766.001-3.182-2.585-5.806-5.768-5.806zm0 10.455c-.908 0-1.637-.24-2.341-.663l-.167-.099-1.579.414.421-1.539-.109-.174c-.459-.731-.726-1.554-.725-2.528.001-2.463 2.003-4.465 4.468-4.465 2.463 0 4.466 2.002 4.467 4.465 0 2.464-2.004 4.589-4.435 4.589z"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href="#" aria-label="لينكد إن" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-300 hover:bg-sap-blue hover:text-white transition flex items-center justify-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <!-- Twitter / X -->
          <a href="#" aria-label="تويتر" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition flex items-center justify-center">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: المنتجات -->
      <div>
        <h4 class="text-white font-bold text-sm mb-4 pb-2 border-b border-slate-800">المنتجات</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#solutions" class="hover:text-white transition">الفوترة والامتثال</a></li>
          <li><a href="#solutions" class="hover:text-white transition">المخزون والمستودعات</a></li>
          <li><a href="#solutions" class="hover:text-white transition">نقاط البيع السريعة POS</a></li>
          <li><a href="#solutions" class="hover:text-white transition">المحاسبة ودفتر الأستاذ</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الموارد البشرية والرواتب</a></li>
          <li><a href="#solutions" class="hover:text-white transition">التقارير والمؤشرات</a></li>
        </ul>
      </div>

      <!-- Column 3: الحلول -->
      <div>
        <h4 class="text-white font-bold text-sm mb-4 pb-2 border-b border-slate-800">الحلول</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#solutions" class="hover:text-white transition">التجارة والتجزئة</a></li>
          <li><a href="#solutions" class="hover:text-white transition">التوزيع والمستودعات</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الصيدليات والمستلزمات</a></li>
          <li><a href="#solutions" class="hover:text-white transition">المطاعم والضيافة</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الشركات متعددة الفروع</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الخدمات والمقاولات</a></li>
        </ul>
      </div>

      <!-- Column 4: الشركة -->
      <div>
        <h4 class="text-white font-bold text-sm mb-4 pb-2 border-b border-slate-800">الشركة</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#why-medo" class="hover:text-white transition">عن MeDo ERP</a></li>
          <li><a href="#why-medo" class="hover:text-white transition">رؤيتنا ورسالتنا</a></li>
          <li><a href="#trust" class="hover:text-white transition">شركاء النجاح</a></li>
          <li><a href="#contact" class="hover:text-white transition">فريق العمل والوظائف</a></li>
          <li><a href="#contact" class="hover:text-white transition">الأخبار والمدونة</a></li>
          <li><a href="https://wa.me/967773586047" target="_blank" class="hover:text-white transition">برنامج الموزعين المعتمدين</a></li>
        </ul>
      </div>

      <!-- Column 5: الدعم الفني -->
      <div>
        <h4 class="text-white font-bold text-sm mb-4 pb-2 border-b border-slate-800">الدعم</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#faq" class="hover:text-white transition">مركز المساعدة والأسئلة</a></li>
          <li><a href="#contact" class="hover:text-white transition">التوثيق الفني للواجهات API</a></li>
          <li><a href="#contact" class="hover:text-white transition">تدريب وتأهيل الكوادر</a></li>
          <li><a href="#contact" class="hover:text-white transition">طلب دعم فني مباشر</a></li>
          <li><a href="#contact" class="hover:text-white transition">حالة الخوادم السحابية</a></li>
          <li><a href="#pricing" class="hover:text-white transition">ترقية الباقات الحالية</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Legal & Copyright -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <p>© {currentYear} منظومة MeDo ERP SaaS السحابية. جميع الحقوق محفوظة.</p>
      </div>

      <div class="flex items-center gap-6">
        <a href="#faq" class="hover:text-white transition">سياسة الخصوصية والأمان</a>
        <span>•</span>
        <a href="#faq" class="hover:text-white transition">شروط وأحكام الخدمة</a>
        <span>•</span>
        <a href="#faq" class="hover:text-white transition">اتفاقية مستوى الخدمة (SLA)</a>
      </div>
    </div>

  </div>
</footer>
