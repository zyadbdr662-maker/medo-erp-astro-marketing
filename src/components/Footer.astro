---
import { supabase } from '../lib/supabase';
const currentYear = new Date().getFullYear();
---
<footer id="contact" class="bg-dark text-slate-300 pt-20 pb-12 border-t border-white/10 font-body">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Newsletter Section -->
    <div class="bg-gradient-to-r from-blue-900/40 to-slate-900/40 border border-white/10 rounded-2xl p-8 mb-16 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex-1">
        <h3 class="text-xl font-heading font-bold text-white mb-2">اشترك في نشرتنا البريدية</h3>
        <p class="text-sm text-slate-400">احصل على آخر تحديثات MeDo ERP والمقالات التقنية مباشرة إلى بريدك.</p>
      </div>
      <form id="newsletter-form" class="w-full md:w-auto flex flex-col sm:flex-row gap-3">
        <input type="email" id="newsletter-email" required placeholder="بريدك الإلكتروني" class="px-4 py-2.5 rounded-lg bg-slate-950 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-cta w-full md:w-64" />
        <button type="submit" class="px-6 py-2.5 rounded-lg bg-cta text-white font-bold hover:bg-blue-600 transition">اشتراك</button>
      </form>
    </div>
    <div id="newsletter-message" class="text-center text-sm font-semibold mb-8"></div>

    <!-- 6 Columns Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10 mb-16">
      
      <!-- Column 1: Brand & Bio & Socials -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3.5 group">
          <div class="w-10 h-10 rounded-lg bg-sap flex items-center justify-center text-white font-heading font-black text-xl shadow-sm group-hover:scale-105 transition-all">
            M
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-heading font-black text-white">MeDo</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-900/60 text-blue-300 border border-blue-700/50">ERP SaaS</span>
            </div>
            <p class="text-[11px] text-slate-400 font-body">سحابي بمعايير عمالقة التكنولوجيا</p>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          المنظومة المحاسبية والإدارية السحابية الأكثر تكاملاً في اليمن، تقدم حلول تخطيط الموارد بمعايير عالمية تناسب الشركات الطموحة والمؤسسات الحديثة.
        </p>

        <!-- Contact Micro Details -->
        <div class="space-y-2 text-xs text-slate-300 pt-2">
          <div class="flex items-center gap-2">
            <span class="text-cta">📍</span>
            <span>صنعاء: شارع حدة | عدن: المنصورة، الشارع العام</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-cta">📞</span>
            <span dir="ltr" class="font-mono-num font-semibold">+967 773 586 047</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-cta">✉️</span>
            <span class="font-mono">support@medo-erp.ye</span>
          </div>
        </div>

        <!-- Social Media Icons (SVGs) -->
        <div class="flex items-center gap-3 pt-3">
          <a href="https://wa.me/967773586047" target="_blank" rel="noopener noreferrer" aria-label="واتساب" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-emerald-600 hover:text-white transition flex items-center justify-center">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.768-2.587 5.768-5.766.001-3.182-2.585-5.806-5.768-5.806zm0 10.455c-.908 0-1.637-.24-2.341-.663l-.167-.099-1.579.414.421-1.539-.109-.174c-.459-.731-.726-1.554-.725-2.528.001-2.463 2.003-4.465 4.468-4.465 2.463 0 4.466 2.002 4.467 4.465 0 2.464-2.004 4.589-4.435 4.589z"/>
            </svg>
          </a>
          <a href="#" aria-label="لينكد إن" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-cta hover:text-white transition flex items-center justify-center">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="#" aria-label="تويتر" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/20 hover:text-white transition flex items-center justify-center">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: المنتجات -->
      <div>
        <h4 class="font-heading text-white font-bold text-sm mb-4 pb-2 border-b border-white/10">المنتجات</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#solutions" class="hover:text-white transition">الفوترة والامتثال</a></li>
          <li><a href="#solutions" class="hover:text-white transition">المخزون والمستودعات</a></li>
          <li><a href="#solutions" class="hover:text-white transition">نقاط البيع السريعة POS</a></li>
          <li><a href="#solutions" class="hover:text-white transition">المحاسبة ودفتر الأستاذ</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الموارد البشرية والرواتب</a></li>
          <li><a href="#solutions" class="hover:text-white transition">التقارير والمؤشرات</a></li>
        </ul>
      </div>

      <!-- Column 3: الحلول -->
      <div>
        <h4 class="font-heading text-white font-bold text-sm mb-4 pb-2 border-b border-white/10">الحلول</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#solutions" class="hover:text-white transition">التجارة والتجزئة</a></li>
          <li><a href="#solutions" class="hover:text-white transition">التوزيع والمستودعات</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الصيدليات والمراكز الطبية</a></li>
          <li><a href="#solutions" class="hover:text-white transition">المطاعم والضيافة</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الشركات متعددة الفروع</a></li>
          <li><a href="#solutions" class="hover:text-white transition">الخدمات والمقاولات</a></li>
        </ul>
      </div>

      <!-- Column 4: الشركة -->
      <div>
        <h4 class="font-heading text-white font-bold text-sm mb-4 pb-2 border-b border-white/10">الشركة</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/about" class="hover:text-white transition">عن MeDo ERP</a></li>
          <li><a href="#why-medo" class="hover:text-white transition">رؤيتنا ورسالتنا</a></li>
          <li><a href="#trust" class="hover:text-white transition">شركاء النجاح</a></li>
          <li><a href="#contact" class="hover:text-white transition">فريق العمل والوظائف</a></li>
          <li><a href="/blog" class="hover:text-white transition">الأخبار والمدونة</a></li>
          <li><a href="https://wa.me/967773586047" target="_blank" class="hover:text-white transition">برنامج الموزعين المعتمدين</a></li>
        </ul>
      </div>

      <!-- Column 5: الدعم الفني -->
      <div>
        <h4 class="font-heading text-white font-bold text-sm mb-4 pb-2 border-b border-white/10">الدعم الفني</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#faq" class="hover:text-white transition">مركز المساعدة والأسئلة</a></li>
          <li><a href="#contact" class="hover:text-white transition">التوثيق الفني للواجهات API</a></li>
          <li><a href="#contact" class="hover:text-white transition">تدريب وتأهيل الكوادر</a></li>
          <li><a href="#contact" class="hover:text-white transition">طلب دعم فني مباشر</a></li>
          <li><a href="#contact" class="hover:text-white transition">حالة الخوادم السحابية</a></li>
          <li><a href="#pricing" class="hover:text-white transition">ترقية الباقات الحالية</a></li>
        </ul>
      </div>

      <!-- Column 6: قانوني -->
      <div>
        <h4 class="font-heading text-white font-bold text-sm mb-4 pb-2 border-b border-white/10">الشؤون القانونية</h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/privacy" class="hover:text-white transition">سياسة الخصوصية</a></li>
          <li><a href="/terms" class="hover:text-white transition">شروط وأحكام الخدمة</a></li>
          <li><a href="/security" class="hover:text-white transition">معايير التشفير والأمان</a></li>
          <li><a href="/sla" class="hover:text-white transition">اتفاقية مستوى الخدمة SLA</a></li>
          <li><a href="#faq" class="hover:text-white transition">سياسة النسخ الاحتياطي</a></li>
          <li><a href="#faq" class="hover:text-white transition">إدارة وتصفية البيانات</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Legal & Made in Yemen -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 font-body">
      <div>
        <p>© {currentYear} منظومة MeDo ERP SaaS السحابية. جميع الحقوق محفوظة.</p>
      </div>

      <!-- Made in Yemen Badge -->
      <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300">
        <span>صُنعت بكل فخر بأيادٍ يمنية</span>
        <span>🇾🇪</span>
        <span class="text-[11px] font-mono-num text-gold font-semibold">Made in Yemen</span>
      </div>

      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-white transition">الخصوصية والأمان</a>
        <span>•</span>
        <a href="/terms" class="hover:text-white transition">الشروط والأحكام</a>
      </div>
    </div>

  </div>
</footer>

<script>
  import { supabase } from '../lib/supabase';
  
  const form = document.querySelector('#newsletter-form') as HTMLFormElement;
  const emailInput = document.querySelector('#newsletter-email') as HTMLInputElement;
  const messageEl = document.querySelector('#newsletter-message') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!supabase) {
      messageEl.textContent = 'نظام التسجيل غير مهيأ حالياً.';
      messageEl.classList.add('text-red-400');
      return;
    }
    messageEl.textContent = 'جاري الاشتراك...';
    messageEl.classList.remove('text-red-400', 'text-green-400');
    
    const { error } = await supabase
      .from('newsletter_subscribers')
      .insert([{ email: emailInput.value, created_at: new Date() }]);
      
    if (error) {
      messageEl.textContent = 'حدث خطأ. يرجى المحاولة لاحقاً.';
      messageEl.classList.add('text-red-400');
    } else {
      messageEl.textContent = 'تم الاشتراك بنجاح!';
      messageEl.classList.add('text-green-400');
      form.reset();
    }
  });
</script>
